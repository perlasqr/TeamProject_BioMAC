import os
import ezc3d
import matplotlib.pyplot as plt

# Configuration
database = 'DB1'
participant = 'P02'
c3d_folder = f'../data/{database}_retargeted/{participant}'
c3d_files = sorted([f for f in os.listdir(c3d_folder) if f.endswith('.c3d')])

# Load the specific file
c3d_ref = ezc3d.c3d(os.path.join(c3d_folder, c3d_files[0]))

# Extract Analog data
# Usually, force/moment data is stored in the 'analogs' group
analog_data = c3d_ref['data']['analogs'][0]

def plot_c3d_data(c3d_obj, plate_number=1):
    """
    Plots GRF and Moments for a specified force plate.
    Adjust labels based on your C3D export settings.
    """
    analog_labels = c3d_obj['parameters']['ANALOG']['LABELS']['value']
    print(f"  > Analog labels:  {analog_labels}")
    
    # Helper to find index of a label
    def get_idx(name):
        return analog_labels.index(name)

    # Define your specific labels here
    grf_labels = [f'Fx{plate_number}', f'Fy{plate_number}', f'Fz{plate_number}']
    mom_labels = [f'Mx{plate_number}', f'My{plate_number}', f'Mz{plate_number}']
    
    #grf_labels = [f'Force.Fx{plate_number}', f'Force.Fy{plate_number}', f'Force.Fz{plate_number}']
    #mom_labels = [f'Moment.Mx{plate_number}', f'Moment.My{plate_number}', f'Moment.Mz{plate_number}']
    #grf_labels = [f'Channel_13', f'Channel_14', f'Channel_15']
    #mom_labels = [f'Channel_10', f'Channel_11', f'Channel_12']
    
    
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), sharex=True)
    
    # Plot GRF
    for lbl in grf_labels:
        ax1.plot(analog_data[get_idx(lbl)], label=lbl)
    ax1.set_title(f'Ground Reaction Forces - Plate {plate_number}')
    ax1.legend()
    
    # Plot Moments
    for lbl in mom_labels:
        ax2.plot(analog_data[get_idx(lbl)], label=lbl)
    ax2.set_title(f'Moments - Plate {plate_number}')
    ax2.legend()
    
    plt.xlabel('Frame')
    plt.tight_layout()
    plt.show()


plot_c3d_data(c3d_ref, plate_number=1)


plot_c3d_data(c3d_ref, plate_number=2)








import pandas as pd
import matplotlib.pyplot as plt
import os
import glob

# 1. Define paths
database = 'DB1'
participant = 'P01'
mot_folder = f'../results/{database}/{participant}/ID/GRF'

# 2. Get only .mot files using glob (easier than sorting listdir)
mot_files = sorted(glob.glob(os.path.join(mot_folder, "*.mot")))

# Load the first file for demonstration
file_to_plot = mot_files[1]

# 3. Read the file
# We look for the 'endheader' string to find where the data starts
def read_mot(file_path):
    with open(file_path, 'r') as f:
        lines = f.readlines()
        
    for i, line in enumerate(lines):
        if 'endheader' in line:
            return pd.read_csv(file_path, skiprows=i+1, sep='\t')

df = read_mot(file_to_plot)
# Assuming your DataFrame is named 'df'
print("The columns in this .mot file are:")
print(df.columns.tolist())

# 4. Plotting
# Adjust these column names to match your specific .mot header
# Common headers: 'ground_force_vx', 'ground_force_vy', 'ground_force_vz'
cols = ['ground_force_calcn_l_vx', 'ground_force_calcn_l_vy', 'ground_force_calcn_l_vz']

fig, axes = plt.subplots(3, 1, figsize=(10, 10), sharex=True)
for i, col in enumerate(cols):
    if col in df.columns:
        axes[i].plot(df['time'], df[col])
        axes[i].set_title(f'Component: {col}')
        axes[i].set_ylabel('Force (N)')
    else:
        axes[i].text(0.5, 0.5, f'Column {col} not found', ha='center')

axes[2].set_xlabel('Time (s)')
plt.tight_layout()
plt.show()
